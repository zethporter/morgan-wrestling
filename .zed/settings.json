{
	"lsp": {
		"biome": {
			"settings": {
				"require_config_file": true
			}
		}
	},
	"formatter": {
		"language_server": {
			"name": "biome"
		}
	},
	"format_on_save": "on",
	"code_actions_on_format": {
		"source.organizeImports": false,
		"source.organizeImports.biome": true
	},
	"languages": {
		"TypeScript": {
			"formatter": "language_server",
			"language_servers": [
				"typescript-ls",
				"!typescript-language-server",
				"biome",
				"..."
			]
		},
		"JavaScript": {
			"formatter": "language_server",
			"language_servers": [
				"typescript-ls",
				"!typescript-language-server",
				"biome",
				"..."
			]
		},
		"TSX": {
			"formatter": "language_server",
			"language_servers": [
				"typescript-ls",
				"!typescript-language-server",
				"biome",
				"..."
			]
		},
		"JSON": {
			"formatter": "language_server",
			"language_servers": [
				"biome"
			]
		}
	}
}
