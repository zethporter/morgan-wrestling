{
  "formatter": "language_server",
  "format_on_save": "on",
  "languages": {
    "TypeScript": {
      "formatter": "language_server",
      "language_servers": [
        "typescript-ls",
        "!typescript-language-server",
        "biome",
        "..."
      ]
    },
    "JavaScript": {
      "formatter": "language_server",
      "language_servers": [
        "typescript-ls",
        "!typescript-language-server",
        "biome",
        "..."
      ]
    },
    "TSX": {
      "formatter": "language_server",
      "language_servers": [
        "typescript-ls",
        "!typescript-language-server",
        "biome",
        "..."
      ]
    },
    "JSON": {
      "formatter": "language_server",
      "language_servers": [
        "biome"
      ]
    }
  },
  "code_actions_on_format": {
    "source.organizeImports.biome": true
  }
}
