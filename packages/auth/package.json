{
  "name": "@morgan-wrestling/auth",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./permissions": "./src/permissions.ts",
    "./lib/auth": "./src/lib/auth.ts",
    "./lib/auth-client": "./src/lib/auth-client.ts"
  },
  "scripts": {
    "auth:generate": "bun run ./scripts/generate-schema.ts",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:up": "bun --bun drizzle-kit up",
    "db:push": "bun --bun drizzle-kit push",
    "db:pull": "bun --bun drizzle-kit pull"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.4",
    "@tursodatabase/serverless": "^1.4.0",
    "better-auth": "^1.7.4",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4"
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
