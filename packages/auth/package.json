{
  "name": "@morgan-wrestling/auth",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "db:generate": "bun x auth@v1.7.0-rc.1 generate --config ./src/config.ts --output ./src/schema.ts",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:push": "bun --bun drizzle-kit push",
    "db:pull": "bun --bun drizzle-kit pull"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.26",
    "better-auth": "^1.6.26",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
