    "db:pull": "bun --bun drizzle-kit pull",
    "db:studio": "bun --bun drizzle-kit studio"
  },
  "dependencies": {
    "@tursodatabase/serverless": "^1.4.0",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
